# Hosted-service settings, added to the server environment next to
# server/.env.example. SITE_URL stays in the core file.

# --- Developer accounts and fixed-price API subscriptions (off by default) ---
# Use a separate database for Stripe sandbox testing and live accounts. Migration
# 034 pins each database to one mode when accounts first start.
COMMERCIAL_API_ENABLED=false
BETTER_AUTH_SECRET=
STRIPE_MODE=sandbox
STRIPE_SECRET_KEY=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_WEBHOOK_SECRET=
# Both gates need operator review before live checkout can start. Stripe Tax
# also requires actual registrations; a sandbox payment proves no tax readiness.
STRIPE_LIVE_READY=false
STRIPE_TAX_REVIEWED=false
STRIPE_TAX_ENABLED=false
STRIPE_TAX_REGISTRATION_CONFIRMED=false
# Leave empty until a dated 30-day anonymous developer API migration is ready.
API_KEY_REQUIRED_AT=

# Authenticated STARTTLS submission; keep credentials out of source control.
# For an isolated local capture mailbox only, set port 1025 and TLS=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_SERVERNAME=
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
