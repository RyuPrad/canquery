$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"},"Retry-After":{"$ref":"#/components/headers/Retry-After"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"},"example":{"error":"Publisher DataStore, map source or tile storage unavailable.","request_id":"example-request-id"}}}},"Error413":{"description":"Viewport exceeds the response/tile bound. Zoom in or reduce the viewport.","x-description-fr":"La vue dépasse la limite de réponse ou de tuiles. Zoomez ou réduisez la zone.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"},"Retry-After":{"$ref":"#/components/headers/Retry-After"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"},"example":{"error":"Viewport exceeds the response/tile bound. Zoom in or reduce the viewport.","request_id":"example-request-id"}}}}},"headers":{"RateLimit-Limit":{"description":"Anonymous or failed-credential rate-limit ceiling when supplied by the limiter; keyed account limits are separate.","schema":{"type":"integer","minimum":0},"x-description-fr":"Plafond des requêtes anonymes ou des échecs d’authentification, lorsqu’il est fourni. Les limites du compte avec clé sont distinctes."},"RateLimit-Remaining":{"description":"Requests remaining in the limiter window, when supplied.","schema":{"type":"integer","minimum":0},"x-description-fr":"Requêtes restantes dans la fenêtre du limiteur, lorsqu’il est fourni."},"RateLimit-Reset":{"description":"Seconds until the limiter window resets, when supplied.","schema":{"type":"integer","minimum":0},"x-description-fr":"Secondes avant la réinitialisation de la fenêtre du limiteur, lorsqu’il est fourni."},"Deprecation":{"description":"Anonymous compatibility deprecation timestamp, when a cutoff is announced.","schema":{"type":"string"},"x-description-fr":"Horodatage d’abandon de la compatibilité anonyme, lorsqu’une date limite est annoncée."},"Sunset":{"description":"HTTP date after which metered routes require a key, when announced.","schema":{"type":"string"},"x-description-fr":"Date HTTP après laquelle les routes comptabilisées exigent une clé, lorsqu’elle est annoncée."},"X-Request-Id":{"description":"Request identifier for support and log correlation.","schema":{"type":"string"},"x-description-fr":"Identifiant de requête pour le soutien et la recherche dans les journaux."},"Cache-Control":{"description":"Keyed API responses are private, no-store. Anonymous routes may use public caching.","schema":{"type":"string"},"x-description-fr":"Les réponses avec clé sont privées, no-store. Les routes anonymes peuvent utiliser un cache public."},"X-CanQuery-Credits-Limit":{"description":"Keyed requests: shared account allowance for the current period.","schema":{"type":"integer","minimum":0},"x-description-fr":"Avec clé : allocation partagée du compte pour la période actuelle."},"X-CanQuery-Credits-Remaining":{"description":"Keyed requests: remaining allowance after admission, including all outstanding reservations; not a final usage receipt.","schema":{"type":"integer","minimum":0},"x-description-fr":"Avec clé : solde après admission, comprenant toutes les réservations en cours; ce n’est pas un reçu d’utilisation définitif."},"X-CanQuery-Credits-Reset":{"description":"Keyed requests: current allowance period end (UTC).","schema":{"type":"string","format":"date-time"},"x-description-fr":"Avec clé : fin de la période d’allocation actuelle (UTC)."},"Retry-After":{"description":"When present, minimum seconds before retrying. Exhausted credits may require waiting until the next allowance period.","schema":{"type":"integer","minimum":1},"x-description-fr":"Si présent, nombre minimum de secondes avant un nouvel essai. Des crédits épuisés peuvent imposer d’attendre la prochaine période."},"Content-Disposition":{"description":"Attachment filename.","schema":{"type":"string"},"x-description-fr":"Nom du fichier joint."},"X-CanQuery-Sources":{"description":"Comma-separated source IDs when available.","schema":{"type":"string"},"x-description-fr":"Identifiants de sources séparés par des virgules, si disponibles."},"X-CanQuery-Snapshot":{"description":"Opaque local snapshot identifier, absent for live DataStore.","schema":{"type":"string"},"x-description-fr":"Identifiant opaque de la copie locale; absent pour le DataStore en direct."},"X-CanQuery-Prepared-At":{"description":"Local preparation time when recorded; not publisher freshness.","schema":{"type":["string","null"],"format":"date-time"},"x-description-fr":"Date de préparation locale, lorsqu’elle est connue."},"X-CanQuery-Retrieved-At":{"description":"Time this extraction began.","schema":{"type":["string","null"],"format":"date-time"},"x-description-fr":"Début de cette extraction."},"Link":{"description":"Primary licence URL with rel=\\"license\\", when available.","schema":{"type":"string"},"x-description-fr":"URL de la licence principale avec rel=\\"license\\", si disponible."}}},"paths":{"/datasets":{"get":{"operationId":"listDatasets","tags":["Discovery"],"summary":"Search datasets","x-summary-fr":"Rechercher des jeux de données","description":"Discover admitted catalogue records. Availability of metadata does not guarantee a working file, table or map. Catalogue reads never request preparation. Follow pagination.nextCursor until null.","x-description-fr":"Découvrez les fiches admises. Des métadonnées présentes ne garantissent pas un fichier, tableau ou carte disponible. Aucune préparation automatique. Suivez pagination.nextCursor jusqu’à null.","x-credit-cost":1,"parameters":[{"name":"q","in":"query","description":"Catalogue search text, trimmed; at most 200 characters.","x-description-fr":"Texte de recherche, espaces extérieurs retirés; 200 caractères maximum.","schema":{"type":"string","maxLength":200},"example":"permits"},{"name":"org","in":"query","description":"Publisher name or identity.","x-description-fr":"Nom ou identifiant de l’éditeur.","schema":{"type":"string","maxLength":200}},{"name":"format","in":"query","description":"Recorded resource format.","x-description-fr":"Format de ressource enregistré.","schema":{"type":"string","maxLength":200}},{"name":"keyword","in":"query","description":"Recorded dataset keyword.","x-description-fr":"Mot-clé du jeu de données.","schema":{"type":"string","maxLength":200}},{"name":"place","in":"query","description":"Canonical place ID or slug; includes configured inherited coverage.","x-description-fr":"Identifiant ou slug canonique du lieu; inclut la couverture héritée configurée.","schema":{"type":"string","maxLength":200}},{"name":"source","in":"query","description":"Catalogue source ID.","x-description-fr":"Identifiant de source du catalogue.","schema":{"type":"string","maxLength":200}},{"name":"mappable","in":"query","description":"Only datasets with maps. Use true or 1; omit to disable. false is invalid.","x-description-fr":"Jeux avec cartes seulement. Utilisez true ou 1; omettez pour désactiver. false est non valide.","schema":{"type":"string","enum":["true","1"]}},{"name":"limit","in":"query","description":"Page size; values above 100 are clamped to 100.","x-description-fr":"Taille de page; les valeurs supérieures à 100 sont ramenées à 100.","schema":{"type":"integer","minimum":1,"maximum":100,"default":20}},{"name":"cursor","in":"query","description":"Nonnegative offset. Pass pagination.nextCursor unchanged; omit for the first page.","x-description-fr":"Décalage positif ou nul. Réutilisez pagination.nextCursor; omettez-le à la première page.","schema":{"type":"integer","minimum":0,"default":0},"example":20}],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/DatasetSummary"}},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":[{"id":"example-dataset","name":"example-permits","title":{"en":"Example permits","fr":"Permis exemples"},"metadata_modified":"2026-01-01T00:00:00.000Z","description":{"en":"Illustrative records.","fr":"Données illustratives."},"resource_count":1,"queryable_count":1,"mappable_count":0,"organization":null,"places":[],"provenance":{"sources":[{"id":"example-source","kind":"ckan","name":{"en":"Example publisher","fr":"Éditeur exemple"},"homepage_url":"https://example.org/","landing_url":"https://example.org/dataset/example","upstream":"example.org","authoritative":true,"license":null}],"primary_license":null}}],"pagination":{"nextCursor":"20"},"meta":{"source":"canquery","license":null,"upstream":null,"search":{"query":"permits","suggestions":[]},"sources":["example-source"]}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"$ref":"#/components/responses/Error503"}}}},"/datasets/{idOrName}":{"get":{"operationId":"getDataset","tags":["Discovery"],"summary":"Get a dataset","x-summary-fr":"Obtenir un jeu de données","description":"Resolve a canonical dataset ID or published name/slug. Includes resources, capabilities and source-specific licence/provenance.","x-description-fr":"Résout un identifiant canonique ou un nom/slug publié. Inclut les ressources, capacités, licences et provenance.","x-credit-cost":1,"parameters":[{"name":"idOrName","in":"path","description":"Canonical dataset ID or published name/slug.","x-description-fr":"Identifiant canonique ou nom/slug publié.","schema":{"type":"string"},"required":true}],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"