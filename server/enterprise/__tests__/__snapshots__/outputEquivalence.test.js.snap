onses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Organization"}},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":[{"id":"example-org","name":"example-publisher","title":{"en":"Example publisher","fr":"Éditeur exemple"},"dataset_count":1,"place":null}],"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"$ref":"#/components/responses/Error503"}}}},"/organizations/{name}":{"get":{"operationId":"getOrganization","tags":["Discovery"],"summary":"Get a publisher","x-summary-fr":"Obtenir un éditeur","description":"Publisher identity, catalogue and capability counts, and place context.","x-description-fr":"Identité de l’éditeur, dénombrements du catalogue et des capacités, et lieu associé.","x-credit-cost":1,"parameters":[{"name":"name","in":"path","description":"Publisher name or identity, at most 200 characters.","x-description-fr":"Nom ou identifiant de l’éditeur, 200 caractères maximum.","schema":{"type":"string","maxLength":200},"required":true}],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Organization"},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":{"id":"example-org","name":"example-publisher","title":{"en":"Example publisher","fr":"Éditeur exemple"},"dataset_count":1,"queryable_dataset_count":1,"mappable_dataset_count":0,"metadata_modified":null,"place":null},"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"$ref":"#/components/responses/Error503"}}}},"/places":{"get":{"operationId":"listPlaces","tags":["Discovery"],"summary":"List places","x-summary-fr":"Lister les lieux","description":"Search canonical geographical identities and their direct/inherited coverage. Uses catalogue pagination.","x-description-fr":"Recherche des lieux canoniques et de leur couverture directe ou héritée. Pagination du catalogue.","x-credit-cost":1,"parameters":[{"name":"q","in":"query","description":"Catalogue search text, trimmed; at most 200 characters.","x-description-fr":"Texte de recherche, espaces extérieurs retirés; 200 caractères maximum.","schema":{"type":"string","maxLength":200},"example":"permits"},{"name":"kind","in":"query","description":"Place type.","x-description-fr":"Type de lieu.","schema":{"type":"string","enum":["country","province","territory","region","municipality"]}},{"name":"parent","in":"query","description":"Canonical parent ID or slug.","x-description-fr":"Identifiant ou slug canonique du parent.","schema":{"type":"string","maxLength":200}},{"name":"featured","in":"query","description":"Use true or 1 for featured places; omit to disable.","x-description-fr":"Utilisez true ou 1 pour les lieux en vedette; omettez pour désactiver.","schema":{"type":"string","enum":["true","1"]}},{"name":"limit","in":"query","description":"Page size; values above 100 are clamped to 100.","x-description-fr":"Taille de page; les valeurs supérieures à 100 sont ramenées à 100.","schema":{"type":"integer","minimum":1,"maximum":100,"default":50}},{"name":"cursor","in":"query","description":"Nonnegative offset. Pass pagination.nextCursor unchanged; omit for the first page.","x-description-fr":"Décalage positif ou nul. Réutilisez pagination.nextCursor; omettez-le à la première page.","schema":{"type":"integer","minimum":0,"default":0},"example":20}],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Place"}},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":[{"id":"example-place","slug":"example-on","kind":"municipality","name":{"en":"Example","fr":"Exemple"},"featured":false,"dataset_count":1}],"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"$ref":"#/components/responses/Error503"}}}},"/places/{idOrSlug}":{"get":{"operationId":"getPlace","tags":["Discovery"],"summary":"Get a place","x-summary-fr":"Obtenir un lieu","description":"Resolve a canonical ID, slug or durable alias. Includes ancestry, children, viewport and coverage. API lookup does not redirect like an HTML alias.","x-description-fr":"Résout un identifiant, slug ou alias durable. Inclut ascendance, enfants, vue et couverture. Aucun renvoi HTML pour les alias.","x-credit-cost":1,"parameters":[{"name":"idOrSlug","in":"path","description":"Canonical place ID, slug or historical alias.","x-description-fr":"Identifiant, slug ou alias historique du lieu.","schema":{"type":"string"},"required":true}],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Place"},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":{"id":"example-place","slug":"example-on","kind":"municipality","name":{"en":"Example","fr":"Exemple"},"ancestors":[],"children":[],"dataset_count":1,"direct_dataset_count":1,"mappable_dataset_count":0},"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null}}}}},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"$ref":"#/components/responses/Error503"}}}},"/sources":{"get":{"operationId":"listSources","tags":["Discovery"],"summary":"List catalogue sources","x-summary-fr":"Lister les sources du catalogue","description":"Persisted publisher portals, provenance hosts, catalogue counts and last successful sync. This endpoint is not paginated.","x-description-fr":"Portails, hôtes de provenance, dénombrements et dernière synchronisation réussie. Sans pagination.","x-credit-cost":1,"parameters":[{"name":"place","in":"query","description":"Canonical place ID or slug; includes configured inherited coverage.","x-description-fr":"Identifiant ou slug canonique du lieu; inclut la couverture héritée configurée.","schema":{"type":"string","maxLength":200}}],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Source"}},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":[{"id":"example-source","kind":"ckan","name":{"en":"Example publisher","fr":"Éditeur exemple"},"homepage_url":"https://example.org/","catalog_url":"https://example.org/api/3/action","upstream":"example.org","dataset_count":1,"authoritative_dataset_count":1,"last_synced_at":null}],"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"$ref":"#/components/responses/Error503"}}}},"/resources/{id}":{"get":{"operationId":"getResource","tags":["Discovery"],"summary":"Inspect resource capabilities","x-summary-fr":"Consulter les capacités d’une ressource","description":"Read query_mode, preparation, ingestion, map and provenance before querying. A map can exist on a file-only table resource. Metadata reads neither prepare files nor renew local-copy activity. Preparation time differs from publisher modification time; source changes can remain undiscovered when publisher version metadata is unchanged.","x-description-fr":"Consultez query_mode, preparation, ingestion, map et provenance avant une requête. Une ressource file-only peut avoir une carte. La lecture ne prépare pas de fichier et ne renouvelle pas la copie locale. La date de préparation diffère de celle de l’éditeur; les changements sans modification des métadonnées de version peuvent passer inaperçus.","x-credit-cost":1,"parameters":[{"name":"id","in":"path","description":"Resource ID from dataset or resource metadata.","x-description-fr":"Identifiant de ressource obtenu dans les métadonnées.","schema":{"type":"string"},"required":true}],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Resource"},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":{"id":"example-resource","dataset_id":"example-dataset","name":{"en":"Example CSV","fr":"CSV exemple"},"format":"CSV","url":"https://example.org/example.csv","size_bytes":null,"datastore_active":true,"language":"en","last_modified":"2026-01-01T00:00:00.000Z","query_mode":"datastore","preparation":{"supported":true,"enabled":true,"freshness":"unprepared","state":"unprepared","job_id":null,"retry_at":null,"failure_reason":null,"prepared_at":null,"publisher_modified_at":"2026-01-01T00:00:00.000Z"},"map":null,"ingestion":null,"dataset":{"id":"example-dataset","name":"example-permits","title":{"en":"Example permits","fr":"Permis exemples"},"metadata_modified":"2026-01-01T00:00:00.000Z"},"places":[],"provenance":{"sources":[{"id":"example-source","kind":"ckan","name":{"en":"Example publisher","fr":"Éditeur exemple"},"homepage_url":"https://example.org/","landing_url":"https://example.org/dataset/example","upstream":"example.org","authoritative":true,"license":null}],"primary_license":null}},"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null}}}}},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"$ref":"#/components/responses/Error503"}}}},"/resources/recently-unlocked":{"get":{"operationId":"listRecentlyPrepared","tags":["Discovery"],"summary":"List recently prepared resources","x-summary-fr":"Lister les ressources récemment préparées","description":"Recent ready local copies. The historical route name is retained. Reading the list does not prepare files.","x-description-fr":"Copies locales prêtes récentes. Le nom historique de la route est conservé. Aucune préparation de fichier.","x-credit-cost":1,"parameters":[{"name":"place","in":"query","description":"Canonical place ID or slug; includes configured inherited coverage.","x-description-fr":"Identifiant ou slug canonique du lieu; inclut la couverture héritée configurée.","schema":{"type":"string","maxLength":200}},{"name":"limit","in":"query","description":"Page size; values above 20 are clamped to 20.","x-description-fr":"Taille de page; les valeurs supérieures à 20 sont ramenées à 20.","schema":{"type":"integer","minimum":1,"maximum":20,"default":6}}],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/ActivityResource"}},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":[{"resource_id":"example-resource","name":{"en":"Example CSV","fr":"CSV exemple"},"format":"CSV","ingested_at":"2026-01-01T00:00:00.000Z","row_count":1,"dataset":{"id":"example-dataset","name":"example-permits","title":{"en":"Example permits","fr":"Permis exemples"},"metadata_modified":"2026-01-01T00:00:00.000Z"}}],"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"$ref":"#/components/responses/Error503"}}}},"/resources/popular":{"get":{"operationId":"listPopularResources","tags":["Discovery"],"summary":"List popular resources","x-summary-fr":"Lister les ressources populaires","description":"Counts CanQuery query-log hits, not publisher downloads.","x-description-fr":"Compte les requêtes enregistrées par CanQuery, pas les téléchargements de l’éditeur.","x-credit-cost":1,"parameters":[{"name":"place","in":"query","description":"Canonical place ID or slug; includes configured inherited coverage.","x-description-fr":"Identifiant ou slug canonique du lieu; inclut la couverture héritée configurée.","schema":{"type":"string","maxLength":200}},{"name":"days","in":"query","description":"Lookback days; values above 30 are clamped.","x-description-fr":"Jours précédents; les valeurs supérieures à 30 sont ramenées à 30.","schema":{"type":"integer","minimum":1,"maximum":30,"default":7}},{"name":"limit","in":"query","description":"Page size; values above 20 are clamped to 20.","x-description-fr":"Taille de page; les valeurs supérieures à 20 sont ramenées à 20.","schema":{"type":"integer","minimum":1,"maximum":20,"default":6}}],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/ActivityResource"}},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":[{"resource_id":"example-resource","hits":3,"last_queried_at":"2026-01-01T00:00:00.000Z","name":{"en":"Example CSV","fr":"CSV exemple"},"format":"CSV","dataset":{"id":"example-dataset","name":"example-permits","title":{"en":"Example permits","fr":"Permis exemples"},"metadata_modified":"2026-01-01T00:00:00.000Z"}}],"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"$ref":"#/components/responses/Error503"}}}},"/resources/{id}/query":{"get":{"operationId":"queryResource","tags":["Query and export"],"summary":"Query rows or aggregate","x-summary-fr":"Interroger ou agréger les lignes","description":"Ready local snapshots take precedence over live CKAN DataStore. Live DataStore supports equality filters only, with no aggregation. Local aggregates cover the complete filtered snapshot; total then counts groups, not rows. Local reads renew copy activity and successful queries record popularity. Local responses include meta.snapshot, retrieval time and deployment limits. Supply snapshot on subsequent pages to require identical stored rows and schema; 409 requires an explicit new extraction. Catalogue provenance and publisher modification timestamps are observed at retrieval, not frozen at preparation. source_metadata_version is not a downloaded-content checksum. A 409 never automatically enqueues preparation; inspect metadata and explicitly use /prepare when supported. Aggregations have an additional 30 requests/minute limit and consume expensive-request concurrency.","x-description-fr":"La copie locale prête a priorité sur le DataStore CKAN. Le DataStore accepte seulement l’égalité, sans agrégation. Les agrégats locaux couvrent toute la copie filtrée; total compte alors les groupes. Les lectures locales renouvellent l’activité et les requêtes réussies alimentent la popularité. Les réponses locales comprennent meta.snapshot, la date de récupération et les limites. Fournissez snapshot aux pages suivantes pour conserver les mêmes données et champs; un 409 exige une nouvelle extraction explicite. La provenance est observée à la récupération. source_metadata_version ne vérifie pas le contenu du fichier. Un 409 ne lance aucune préparation; consultez les métadonnées et utilisez /prepare explicitement. Les agrégations sont aussi limitées à 30/minute et consomment la concurrence des requêtes coûteuses.","x-credit-cost":"1 row query / 10 aggregation","parameters":[{"name":"id","in":"path","description":"Resource ID from dataset or resource metadata.","x-description-fr":"Identifiant de ressource obtenu dans les métadonnées.","schema":{"type":"string"},"required":true},{"name":"snapshot","in":"query","description":"Require this exact local snapshot. A replaced or unavailable copy returns 409 SNAPSHOT_UNAVAILABLE; no automatic fallback or preparation. This token does not promise retention or source-content freshness.","x-description-fr":"Exige cette copie locale exacte. Une copie remplacée ou indisponible retourne 409 SNAPSHOT_UNAVAILABLE, sans remplacement ni préparation automatique. Aucun engagement de conservation ou de fraîcheur du fichier source.","schema":{"type":"string","pattern":"^cqs1_[0-9a-f]{64}$"}},{"name":"q","in":"query","description":"Search within resource rows (not catalogue search); at most 200 characters. Local search uses case-insensitive ILIKE patterns.","x-description-fr":"Recherche dans les lignes, distincte du catalogue; 200 caractères maximum. Recherche locale ILIKE insensible à la casse.","schema":{"type":"string","maxLength":200}},{"name":"filters","in":"query","description":"URL-encoded JSON object, at most 2,000 characters and 20 column keys of 1–63 characters. Exact recorded field names; conditions combine with AND. Scalars mean equality. Objects use op and value: eq, lt, gt, lte, gte, contains. Live DataStore supports eq only. eq:null means IS NULL locally; contains preserves % and _ SQL wildcard meanings.","x-description-fr":"Objet JSON encodé dans l’URL : 2 000 caractères, 20 champs de 1 à 63 caractères maximum. Noms exacts, conditions AND. Scalaire = égalité; objets op/value : eq, lt, gt, lte, gte, contains. DataStore : eq seulement. Localement, eq:null signifie IS NULL; contains conserve les jokers SQL % et _.","schema":{"type":"string","maxLength":2000},"example":"{\\"STREET_NAME\\":\\"YONGE\\"}"},{"name":"sort","in":"query","description":"Exact field name, optionally followed by asc or desc. Local row sorting also accepts _id; aggregates accept key or value. An exact field name wins over a direction suffix. Live DataStore values are limited to 100 characters.","x-description-fr":"Nom exact du champ, suivi éventuellement de asc ou desc. Lignes locales : _id aussi accepté; agrégats : key ou value. Le nom exact a priorité sur le suffixe. DataStore : 100 caractères maximum.","schema":{"type":"string"},"example":"STREET_NAME asc"},{"name":"group_by","in":"query","description":"Prepared tables only: exact recorded grouping field. Required together with agg.","x-description-fr":"Tables préparées : champ de regroupement exact, obligatoire avec agg.","schema":{"type":"string"},"example":"STREET_NAME"},{"name":"agg","in":"query","description":"Prepared tables only. count forbids agg_column; other functions require it. sum/avg require a numeric field.","x-description-fr":"Tables préparées : count interdit agg_column; les autres fonctions l’exigent. sum/avg exigent un champ numérique.","schema":{"type":"string","enum":["count","sum","avg","min","max"]},"example":"count"},{"name":"agg_column","in":"query","description":"Recorded measure field for sum, avg, min or max; forbidden with count.","x-description-fr":"Champ de mesure pour sum, avg, min ou max; interdit avec count.","schema":{"type":"string"}},{"name":"bucket","in":"query","description":"Optional temporal grouping; group_by must be DATE or TIMESTAMPTZ.","x-description-fr":"Regroupement temporel facultatif; group_by doit être DATE ou TIMESTAMPTZ.","schema":{"type":"string","enum":["year","month","day"]}},{"name":"limit","in":"query","description":"Page size; values above 100 are clamped to 100.","x-description-fr":"Taille de page; les valeurs supérieures à 100 sont ramenées à 100.","schema":{"type":"integer","minimum":1,"maximum":100,"default":20}},{"name":"offset","in":"query","description":"Row/group offset; independent of catalogue cursor. Avoid relying on a stable snapshot across page calls.","x-description-fr":"Décalage de lignes/groupes, distinct du curseur du catalogue. Aucune copie stable garantie entre les pages.","schema":{"type":"integer","minimum":0,"maximum":10000,"default":0}}],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/QueryResult"},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"examples":{"rows":{"summary":"Illustrative live DataStore response","x-summary-fr":"Exemple de réponse DataStore en direct","value":{"data":{"fields":[{"id":"_id","type":"int"},{"id":"STREET_NAME","type":"text"}],"records":[{"_id":1,"STREET_NAME":"EXAMPLE"}],"total":1},"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":"example.org","query_mode":"datastore","provenance":{"sources":[{"id":"example-source","kind":"ckan","name":{"en":"Example publisher","fr":"Éditeur exemple"},"homepage_url":"https://example.org/","landing_url":"https://example.org/dataset/example","upstream":"example.org","authoritative":true,"license":null}],"primary_license":null},"sources":["example-source"]}}},"aggregate":{"summary":"Illustrative complete-snapshot aggregate; numeric database values can be strings","x-summary-fr":"Exemple d’agrégat de la copie complète; les nombres peuvent être des chaînes","value":{"data":{"fields":[{"id":"key","type":"TEXT"},{"id":"value","type":"INTEGER"}],"records":[{"key":"EXAMPLE","value":"2"}],"total":1},"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null,"query_mode":"ingested","aggregation":{"group_by":"STREET_NAME","agg":"count","agg_column":null,"bucket":null},"provenance":{"sources":[{"id":"example-source","kind":"ckan","name":{"en":"Example publisher","fr":"Éditeur exemple"},"homepage_url":"https://example.org/","landing_url":"https://example.org/dataset/example","upstream":"example.org","authoritative":true,"license":null}],"primary_license":null}}}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"422":{"$ref":"#/components/responses/Error422"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"502":{"$ref":"#/components/responses/Error502"},"503":{"$ref":"#/components/responses/Error503"}},"x-credit-cost-fr":"1 requête de lignes / 10 agrégation"}},"/resources/{id}/query.csv":{"get":{"operationId":"exportResourceCsv","tags":["Query and export"],"summary":"Export a bounded CSV","x-summary-fr":"Exporter un CSV limité","description":"Exports from offset zero, at most 10000 rows (deployment cap; hard maximum 10,000). Same query capabilities as /query, including local full-snapshot aggregation before limiting groups. There is no CSV pagination or full-file guarantee. Use the original download for complete publisher files. Formula-like spreadsheet cells are neutralized. A failure after headers closes the partial response: discard incomplete output and retry within limits. Keyed failed/interrupted exports are refunded. Ten exports/minute plus plan request/concurrency limits.","x-description-fr":"Exporte à partir de zéro, au plus 10000 lignes (limite de déploiement; plafond absolu de 10 000). Mêmes capacités que /query, y compris l’agrégation locale complète avant de limiter les groupes. Aucune pagination CSV ni garantie de fichier complet. Le téléchargement original donne le fichier de l’éditeur. Les formules de tableur sont neutralisées. Une erreur après les en-têtes ferme la réponse partielle : jetez ce fichier et réessayez dans les limites. Les exports authentifiés échoués ou interrompus sont remboursés. Dix exports/minute, sous réserve du forfait.","x-credit-cost":25,"parameters":[{"name":"id","in":"path","description":"Resource ID from dataset or resource metadata.","x-description-fr":"Identifiant de ressource obtenu dans les métadonnées.","schema":{"type":"string"},"required":true},{"name":"snapshot","in":"query","description":"Require this exact local snapshot. A replaced or unavailable copy returns 409 SNAPSHOT_UNAVAILABLE; no automatic fallback or preparation. This token does not promise retention or source-content freshness.","x-description-fr":"Exige cette copie locale exacte. Une copie remplacée ou indisponible retourne 409 SNAPSHOT_UNAVAILABLE, sans remplacement ni préparation automatique. Aucun engagement de conservation ou de fraîcheur du fichier source.","schema":{"type":"string","pattern":"^cqs1_[0-9a-f]{64}$"}},{"name":"q","in":"query","description":"Search within resource rows (not catalogue search); at most 200 characters. Local search uses case-insensitive ILIKE patterns.","x-description-fr":"Recherche dans les lignes, distincte du catalogue; 200 caractères maximum. Recherche locale ILIKE insensible à la casse.","schema":{"type":"string","maxLength":200}},{"name":"filters","in":"query","description":"URL-encoded JSON object, at most 2,000 characters and 20 column keys of 1–63 characters. Exact recorded field names; conditions combine with AND. Scalars mean equality. Objects use op and value: eq, lt, gt, lte, gte, contains. Live DataStore supports eq only. eq:null means IS NULL locally; contains preserves % and _ SQL wildcard meanings.","x-description-fr":"Objet JSON encodé dans l’URL : 2 000 caractères, 20 champs de 1 à 63 caractères maximum. Noms exacts, conditions AND. Scalaire = égalité; objets op/value : eq, lt, gt, lte, gte, contains. DataStore : eq seulement. Localement, eq:null signifie IS NULL; contains conserve les jokers SQL % et _.","schema":{"type":"string","maxLength":2000},"example":"{\\"STREET_NAME\\":\\"YONGE\\"}"},{"name":"sort","in":"query","description":"Exact field name, optionally followed by asc or desc. Local row sorting also accepts _id; aggregates accept key or value. An exact field name wins over a direction suffix. Live DataStore values are limited to 100 characters.","x-description-fr":"Nom exact du champ, suivi éventuellement de asc ou desc. Lignes locales : _id aussi accepté; agrégats : key ou value. Le nom exact a priorité sur le suffixe. DataStore : 100 caractères maximum.","schema":{"type":"string"},"example":"STREET_NAME asc"},{"name":"group_by","in":"query","description":"Prepared tables only: exact recorded grouping field. Required together with agg.","x-description-fr":"Tables préparées : champ de regroupement exact, obligatoire avec agg.","schema":{"type":"string"},"example":"STREET_NAME"},{"name":"agg","in":"query","description":"Prepared tables only. count forbids agg_column; other functions require it. sum/avg require a numeric field.","x-description-fr":"Tables préparées : count interdit agg_column; les autres fonctions l’exigent. sum/avg exigent un champ numérique.","schema":{"type":"string","enum":["count","sum","avg","min","max"]},"example":"count"},{"name":"agg_column","in":"query","description":"Recorded measure field for sum, avg, min or max; forbidden with count.","x-description-fr":"Champ de mesure pour sum, avg, min ou max; interdit avec count.","schema":{"type":"string"}},{"name":"bucket","in":"query","description":"Optional temporal grouping; group_by must be DATE or TIMESTAMPTZ.","x-description-fr":"Regroupement temporel facultatif; group_by doit être DATE ou TIMESTAMPTZ.","schema":{"type":"string","enum":["year","month","day"]}}],"responses":{"200":{"description":"CSV attachment (UTF-8); no JSON envelope.","x-description-fr":"Pièce jointe CSV UTF-8, sans enveloppe JSON.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"},"Content-Disposition":{"$ref":"#/components/headers/Content-Disposition"},"X-CanQuery-Sources":{"$ref":"#/components/headers/X-CanQuery-Sources"},"X-CanQuery-Snapshot":{"$ref":"#/components/headers/X-CanQuery-Snapshot"},"X-CanQuery-Prepared-At":{"$ref":"#/components/headers/X-CanQuery-Prepared-At"},"X-CanQuery-Retrieved-At":{"$ref":"#/components/headers/X-CanQuery-Retrieved-At"},"Link":{"$ref":"#/components/headers/Link"}},"content":{"text/csv":{"schema":{"type":"string"},"example":"_id,STREET_NAME\\n1,EXAMPLE\\n"}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"422":{"$ref":"#/components/responses/Error422"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"502":{"$ref":"#/components/responses/Error502"},"503":{"$ref":"#/components/responses/Error503"}}}},"/resources/{id}/profile":{"get":{"operationId":"profileResource","tags":["Query and export"],"summary":"Profile a prepared table","x-summary-fr":"Profiler une table préparée","description":"Requires a ready local snapshot. Describes the whole file, not current filters. At most the first 60 recorded non-_id fields; numeric fields add min/max/avg and date fields min/max. Successful reads renew activity. Twenty requests/minute plus plan request/concurrency limits.","x-description-fr":"Exige une copie locale prête. Décrit le fichier entier, sans filtres. Les 60 premiers champs enregistrés hors _id au maximum; champs numériques avec min/max/avg, dates avec min/max. Renouvelle l’activité. Vingt requêtes/minute, sous réserve du forfait.","x-credit-cost":10,"parameters":[{"name":"id","in":"path","description":"Resource ID from dataset or resource metadata.","x-description-fr":"Identifiant de ressource obtenu dans les métadonnées.","schema":{"type":"string"},"required":true},{"name":"snapshot","in":"query","description":"Require this exact local snapshot. A replaced or unavailable copy returns 409 SNAPSHOT_UNAVAILABLE; no automatic fallback or preparation. This token does not promise retention or source-content freshness.","x-description-fr":"Exige cette copie locale exacte. Une copie remplacée ou indisponible retourne 409 SNAPSHOT_UNAVAILABLE, sans remplacement ni préparation automatique. Aucun engagement de conservation ou de fraîcheur du fichier source.","schema":{"type":"string","pattern":"^cqs1_[0-9a-f]{64}$"}}],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Profile"},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":{"row_count":1,"columns":[{"id":"STREET_NAME","type":"TEXT","distinct":1,"nulls":0}]},"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null,"query_mode":"ingested","provenance":{"sources":[{"id":"example-source","kind":"ckan","name":{"en":"Example publisher","fr":"Éditeur exemple"},"homepage_url":"https://example.org/","landing_url":"https://example.org/dataset/example","upstream":"example.org","authoritative":true,"license":null}],"primary_license":null}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"422":{"$ref":"#/components/responses/Error422"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"$ref":"#/components/responses/Error503"}}}},"/resources/{id}/prepare":{"post":{"operationId":"prepareResource","tags":["Preparation"],"summary":"Prepare or refresh a file","x-summary-fr":"Préparer ou actualiser un fichier","description":"No body. Returns 200 for a current copy or 202 for a new/shared job. Only a newly admitted job deducts preparation credits. A terminal failure without a result published by that job returns the actual debit to its original allowance period exactly once. Retries retain the charge; stopping polling does not fail the job. A failed refresh returns its own charge even if an older copy still serves. A successful empty table counts as success; later expiry or eviction does not return credits. This is an account-credit reversal, not a payment refund. Current copies, joins and polling cost zero but still count toward request limits. Keyed new jobs are capped at 20/account/hour; anonymous admission has a configured per-IP limit. A shared active-queue ceiling and format/size/row/column/storage caps also apply. A stale copy can continue serving during refresh. Paused admission returns 429 even for current copies. Anonymous requests from self-identified crawlers can read current copies and join shared jobs but cannot start new ones (429 AUTOMATED_CLIENT). Honour cooldown Retry-After; a new source version can bypass the old cooldown. No scheduled-refresh guarantee.","x-description-fr":"Sans corps. Retourne 200 pour une copie actuelle ou 202 pour une tâche nouvelle/partagée. Seule une nouvelle admission déduit des crédits. Un échec définitif sans publication par cette tâche rend une seule fois le débit réel à sa période d’origine. Les réessais gardent le débit; arrêter le suivi ne fait pas échouer la tâche. Un renouvellement échoué rend son débit même si une ancienne copie reste disponible. Une table vide valide compte comme un succès; son expiration ultérieure ne rend pas les crédits. Aucun remboursement de paiement. Copie actuelle, tâche partagée et suivi : zéro crédit, mais comptent dans la fréquence. Maximum de 20 admissions/compte/heure avec clé; limite anonyme par IP configurée. La file commune et les plafonds de format, taille, lignes, colonnes et stockage s’appliquent. Une ancienne copie peut rester disponible. Une pause donne 429 même pour une copie actuelle. Sans clé, un robot d’indexation identifié peut lire une copie actuelle ou rejoindre une tâche partagée, mais pas en lancer une nouvelle (429 AUTOMATED_CLIENT). Respectez Retry-After; une nouvelle version peut contourner l’ancien délai. Aucune actualisation planifiée garantie.","x-credit-cost":"100 new job / 0 existing","parameters":[{"name":"id","in":"path","description":"Resource ID from dataset or resource metadata.","x-description-fr":"Identifiant de ressource obtenu dans les métadonnées.","schema":{"type":"string"},"required":true}],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/PreparationJob"},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":{"id":null,"resource_id":"example-resource","status":"done","already_loaded":true,"row_count":1,"prepared_at":"2026-01-01T00:00:00.000Z"},"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null}}}}},"202":{"description":"New or shared job. Poll GET /jobs/{id}, then re-read resource metadata.","x-description-fr":"Tâche nouvelle ou partagée. Suivez GET /jobs/{id}, puis relisez les métadonnées.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/PreparationJob"},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":{"id":123,"resource_id":"example-resource","status":"pending","created_at":"2026-01-01T00:00:00.000Z","serving_cached":false,"prepared_at":null},"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null}}}}},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"422":{"$ref":"#/components/responses/Error422"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"$ref":"#/components/responses/Error503"}},"x-credit-cost-fr":"100 nouvelle tâche / 0 existante"}},"/resources/{id}/ingest":{"post":{"operationId":"ingestResourceLegacy","tags":["Preparation"],"summary":"Prepare a file (legacy)","x-summary-fr":"Préparer un fichier (historique)","description":"No body. Compatibility endpoint; new integrations should use /prepare for freshness and refresh. It returns an existing ready copy without refreshing stale data. Five requests/hour, plus shared limits. New-job charging matches /prepare.","x-description-fr":"Sans corps. Compatibilité : utilisez /prepare pour gérer l’actualité et le renouvellement. Renvoie une copie prête sans actualiser une copie ancienne. Cinq requêtes/heure, plus les limites communes. Même coût d’admission que /prepare.","x-credit-cost":"100 new job / 0 existing","parameters":[{"name":"id","in":"path","description":"Resource ID from dataset or resource metadata.","x-description-fr":"Identifiant de ressource obtenu dans les métadonnées.","schema":{"type":"string"},"required":true}],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Job"},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":{"id":null,"resource_id":"example-resource","status":"done","attempts":0,"retry_at":null,"failure_reason":null,"error":null,"created_at":"2026-01-01T00:00:00.000Z","claimed_at":null,"finished_at":null,"age_seconds":0,"already_loaded":true,"row_count":1},"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null}}}}},"202":{"description":"New or shared legacy preparation job.","x-description-fr":"Tâche de préparation historique nouvelle ou partagée.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Job"},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":{"id":123,"resource_id":"example-resource","status":"pending","attempts":0,"retry_at":null,"failure_reason":null,"error":null,"created_at":"2026-01-01T00:00:00.000Z","claimed_at":null,"finished_at":null,"age_seconds":0},"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null}}}}},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"422":{"$ref":"#/components/responses/Error422"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"$ref":"#/components/responses/Error503"}},"deprecated":true,"x-credit-cost-fr":"100 nouvelle tâche / 0 existante"}},"/resources/{id}/activity":{"post":{"operationId":"renewResourceActivity","tags":["Preparation"],"summary":"Renew local-copy activity","x-summary-fr":"Renouveler l’activité d’une copie","description":"No body. Renews an existing ready copy without preparing a file or recording popularity. A 409 means the copy is unavailable or replaced; re-read metadata. Zero credits still counts toward request limits.","x-description-fr":"Sans corps. Renouvelle une copie prête, sans préparation ni popularité. Un 409 indique une copie absente ou remplacée : relisez les métadonnées. Zéro crédit compte toujours dans la fréquence.","x-credit-cost":0,"parameters":[{"name":"id","in":"path","description":"Resource ID from dataset or resource metadata.","x-description-fr":"Identifiant de ressource obtenu dans les métadonnées.","schema":{"type":"string"},"required":true}],"responses":{"204":{"description":"Activity renewed; empty body.","x-description-fr":"Activité renouvelée; corps vide.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}}},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"409":{"$ref":"#/components/responses/Error409"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"$ref":"#/components/responses/Error503"}}}},"/jobs/{id}":{"get":{"operationId":"getPreparationJob","tags":["Preparation"],"summary":"Poll a preparation job","x-summary-fr":"Suivre une tâche de préparation","description":"Poll one request at a time with a bounded delay and honour Retry-After on errors. A done job is historical: re-read resource metadata before querying because a prepared copy may expire. Failure messages are sanitized; failure_reason and retry_at explain retry eligibility. Zero credits still counts toward request limits.","x-description-fr":"Une requête de suivi à la fois, avec délai borné; respectez Retry-After en cas d’erreur. Une tâche done est historique : relisez les métadonnées, car une copie peut expirer. Messages assainis; failure_reason et retry_at décrivent le nouvel essai. Zéro crédit compte dans la fréquence.","x-credit-cost":0,"parameters":[{"name":"id","in":"path","description":"Positive job ID returned by preparation.","x-description-fr":"Identifiant positif reçu lors de la préparation.","schema":{"type":"integer","minimum":1},"required":true}],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Job"},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":{"id":123,"resource_id":"example-resource","status":"pending","attempts":0,"retry_at":null,"failure_reason":null,"error":null,"created_at":"2026-01-01T00:00:00.000Z","claimed_at":null,"finished_at":null,"age_seconds":0},"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"$ref":"#/components/responses/Error503"}}}},"/resources/{id}/map":{"get":{"operationId":"getMapViewport","tags":["Maps"],"summary":"Get a bounded map viewport","x-summary-fr":"Obtenir une vue cartographique limitée","description":"Enveloped WGS84 GeoJSON for admitted ArcGIS, local PostGIS or PMTiles maps. live=true identifies the viewport interface; it does not promise a publisher fetch on every call. Check returned/truncated; requests are capped at 1,000 features and 8 MiB. PMTiles viewport decoding also bounds tile count. Sixty viewport calls/minute plus plan request/concurrency limits.","x-description-fr":"GeoJSON WGS84 enveloppé pour ArcGIS, PostGIS local ou PMTiles admis. live=true désigne l’interface, pas une lecture de l’éditeur à chaque appel. Consultez returned/truncated : 1 000 entités et 8 Mio maximum. Le décodage PMTiles limite aussi les tuiles. Soixante appels/minute, sous réserve du forfait.","x-credit-cost":10,"parameters":[{"name":"id","in":"path","description":"Resource ID from dataset or resource metadata.","x-description-fr":"Identifiant de ressource obtenu dans les métadonnées.","schema":{"type":"string"},"required":true},{"name":"bbox","in":"query","description":"Required WGS84 west,south,east,north: -180 ≤ west < east ≤ 180 and -90 ≤ south < north ≤ 90.","x-description-fr":"Requis : ouest,sud,est,nord en WGS84. -180 ≤ ouest < est ≤ 180; -90 ≤ sud < nord ≤ 90.","schema":{"type":"string"},"required":true,"example":"-79.5,43.6,-79.3,43.8"},{"name":"zoom","in":"query","description":"Integer zoom level.","x-description-fr":"Niveau de zoom entier.","schema":{"type":"integer","minimum":0,"maximum":22,"default":11}},{"name":"limit","in":"query","description":"Feature ceiling; out-of-range values return 400.","x-description-fr":"Plafond d’entités; hors limites : 400.","schema":{"type":"integer","minimum":1,"maximum":1000,"default":1000}}],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/FeatureCollection"},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":{"type":"FeatureCollection","features":[]},"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null,"map":{"live":true,"provider":"arcgis","geometry_type":"point","fields":[],"returned":0,"truncated":false,"indexed_at":null},"provenance":{"sources":[{"id":"example-source","kind":"ckan","name":{"en":"Example publisher","fr":"Éditeur exemple"},"homepage_url":"https://example.org/","landing_url":"https://example.org/dataset/example","upstream":"example.org","authoritative":true,"license":null}],"primary_license":null}}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"413":{"$ref":"#/components/responses/Error413"},"422":{"$ref":"#/components/responses/Error422"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"502":{"$ref":"#/components/responses/Error502"},"503":{"$ref":"#/components/responses/Error503"}}}},"/resources/{id}/map/tiles/{version}/{z}/{x}/{y}.pbf":{"get":{"operationId":"getMapTile","tags":["Maps"],"summary":"Get a vector tile","x-summary-fr":"Obtenir une tuile vectorielle","description":"PMTiles maps only. Copy the current tiles template/version and zoom range from resource metadata. Coordinates must fit the tile grid and archive zoom range. Anonymous successful tiles cache immutably for one year; keyed responses remain private, no-store. Up to 240 tiles/minute, also subject to the keyed plan request limit.","x-description-fr":"Cartes PMTiles seulement. Utilisez le modèle tiles, la version et la plage de zoom des métadonnées. Les coordonnées doivent respecter la grille et l’archive. Cache anonyme immuable d’un an; réponses avec clé privées, no-store. Maximum de 240 tuiles/minute, et limite du forfait avec clé.","x-credit-cost":1,"parameters":[{"name":"id","in":"path","description":"Resource ID from dataset or resource metadata.","x-description-fr":"Identifiant de ressource obtenu dans les métadonnées.","schema":{"type":"string"},"required":true},{"name":"version","in":"path","description":"Current map version from resource metadata.","x-description-fr":"Version actuelle issue des métadonnées.","schema":{"type":"string"},"required":true},{"name":"z","in":"path","description":"Zoom within this archive’s min_zoom/max_zoom (0–22).","x-description-fr":"Zoom dans min_zoom/max_zoom de l’archive (0–22).","schema":{"type":"integer","minimum":0,"maximum":22},"required":true},{"name":"x","in":"path","description":"Tile coordinate from 0 through 2^z − 1.","x-description-fr":"Coordonnée de 0 à 2^z − 1.","schema":{"type":"integer","minimum":0},"required":true},{"name":"y","in":"path","description":"Tile coordinate from 0 through 2^z − 1.","x-description-fr":"Coordonnée de 0 à 2^z − 1.","schema":{"type":"integer","minimum":0},"required":true}],"responses":{"200":{"description":"Vector-tile protobuf bytes; no JSON envelope.","x-description-fr":"Octets protobuf de la tuile, sans enveloppe JSON.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/x-protobuf":{"schema":{"type":"string","format":"binary"}}}},"204":{"description":"No tile at these coordinates; empty body.","x-description-fr":"Aucune tuile à ces coordonnées; corps vide.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"502":{"$ref":"#/components/responses/Error502"},"503":{"$ref":"#/components/responses/Error503"}}}},"/stats":{"get":{"operationId":"getCatalogueStats","tags":["Discovery"],"summary":"Get catalogue statistics","x-summary-fr":"Obtenir les statistiques du catalogue","description":"Briefly cached counts; capabilities overlap. These are dated observations, not guaranteed coverage or publisher availability.","x-description-fr":"Dénombrements brièvement mis en cache; les capacités se chevauchent. Observations datées, sans garantie de couverture ni de disponibilité.","x-credit-cost":1,"parameters":[],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Stats"},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":{"datasets":1,"resources":1,"datastore_active_resources":1,"ingested_resources":0,"mappable_resources":0,"store_bytes":0,"organizations":1,"places":1,"last_synced_at":null},"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null}}}}},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"$ref":"#/components/responses/Error503"}}}},"/insights/top-downloads":{"get":{"operationId":"getTopDownloads","tags":["Guides and insights"],"summary":"Get the publisher download leaderboard","x-summary-fr":"Obtenir le classement des téléchargements","description":"Publisher-reported download statistics with selected representatives. Distinct from CanQuery query popularity; meta.period identifies the reporting month.","x-description-fr":"Statistiques de téléchargements de l’éditeur et ressources représentatives. Distinctes de la popularité CanQuery; meta.period précise le mois.","x-credit-cost":1,"parameters":[{"name":"lang","in":"query","description":"French when fr; otherwise English.","x-description-fr":"Français avec fr; anglais autrement.","schema":{"type":"string","default":"en"},"example":"en"}],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/TopDownload"}},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":[{"rank":1,"dataset_id":"example-dataset","title":{"en":"Example permits","fr":"Permis exemples"},"department":"Example","ministere":"Exemple","downloads":10,"history":[],"resource_id":"example-resource","ingest_status":null,"row_count":null}],"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null,"period":{"year":2026,"month":1}}}}}},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"$ref":"#/components/responses/Error503"}}}},"/insights/featured":{"get":{"operationId":"getFeaturedPreviews","tags":["Guides and insights"],"summary":"Get prepared chart previews","x-summary-fr":"Obtenir les aperçus de graphiques","description":"Up to 12 validated previews from already prepared Top 100 representatives. No preparation is admitted. Context gives aggregation, snapshot time, displayed/total groups and known missing metrics; this is neither a chart-rendering API nor a scheduled-refresh service.","x-description-fr":"Jusqu’à 12 aperçus validés de ressources du Top 100 déjà préparées. Aucune préparation. Le contexte précise agrégat, date de copie, groupes et mesures manquantes connues; ce n’est ni une API de rendu ni un service d’actualisation planifiée.","x-credit-cost":10,"parameters":[{"name":"lang","in":"query","description":"French when fr; otherwise English.","x-description-fr":"Français avec fr; anglais autrement.","schema":{"type":"string","default":"en"},"example":"en"}],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/FeaturedPreview"}},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":[],"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null}}}}},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"$ref":"#/components/responses/Error503"}}}},"/blog":{"get":{"operationId":"listGuides","tags":["Guides and insights"],"summary":"List data guides","x-summary-fr":"Lister les guides de données","description":"Published guide summaries; reads bundled content without querying the catalogue.","x-description-fr":"Résumés des guides publiés; lit le contenu inclus sans consulter le catalogue.","x-credit-cost":1,"parameters":[{"name":"lang","in":"query","description":"Guide language; must be en or fr.","x-description-fr":"Langue des guides : en ou fr.","schema":{"type":"string","enum":["en","fr"],"default":"en"}},{"name":"place","in":"query","description":"Guide place slug.","x-description-fr":"Slug du lieu associé au guide.","schema":{"type":"string"}},{"name":"dataset","in":"query","description":"Canonical dataset ID or published slug.","x-description-fr":"Identifiant canonique ou slug publié du jeu.","schema":{"type":"string"}}],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"type":"array","items":{"$ref":"#/components/schemas/Article"}},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":[],"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null}}}}},"400":{"$ref":"#/components/responses/Error400"},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"$ref":"#/components/responses/Error503"}}}},"/blog/{lang}/{slug}":{"get":{"operationId":"getGuide","tags":["Guides and insights"],"summary":"Get a data guide","x-summary-fr":"Obtenir un guide de données","description":"Published guide edition including sanitized bodyHtml and translation links.","x-description-fr":"Édition publiée avec bodyHtml assaini et liens des traductions.","x-credit-cost":1,"parameters":[{"name":"lang","in":"path","description":"Guide edition language.","x-description-fr":"Langue de l’édition.","schema":{"type":"string","enum":["en","fr"]},"required":true},{"name":"slug","in":"path","description":"Published localized guide slug.","x-description-fr":"Slug localisé du guide publié.","schema":{"type":"string"},"required":true}],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Article"},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":{"id":"example-guide","lang":"en","slug":"example-guide","path":"/blog/example-guide","title":"Example guide","description":"Illustrative guide.","bodyHtml":"<p>Example guide content.</p>","translations":{"en":"/blog/example-guide","fr":"/fr/blog/guide-exemple"}},"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null}}}}},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"$ref":"#/components/responses/Error503"}}}},"/repo":{"get":{"operationId":"getRepositoryMetadata","tags":["Guides and insights"],"summary":"Get repository metadata","x-summary-fr":"Obtenir les métadonnées du dépôt","description":"Cached public GitHub star count. data may be null when GitHub is unavailable.","x-description-fr":"Nombre d’étoiles GitHub publiques en cache. data peut être null si GitHub est indisponible.","x-credit-cost":1,"parameters":[],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"RateLimit-Limit":{"$ref":"#/components/headers/RateLimit-Limit"},"RateLimit-Remaining":{"$ref":"#/components/headers/RateLimit-Remaining"},"RateLimit-Reset":{"$ref":"#/components/headers/RateLimit-Reset"},"Deprecation":{"$ref":"#/components/headers/Deprecation"},"Sunset":{"$ref":"#/components/headers/Sunset"},"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"},"X-CanQuery-Credits-Limit":{"$ref":"#/components/headers/X-CanQuery-Credits-Limit"},"X-CanQuery-Credits-Remaining":{"$ref":"#/components/headers/X-CanQuery-Credits-Remaining"},"X-CanQuery-Credits-Reset":{"$ref":"#/components/headers/X-CanQuery-Credits-Reset"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"anyOf":[{"type":"object","properties":{"stars":{"type":"integer","minimum":0}}},{"type":"null"}]},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":{"stars":1},"pagination":{"nextCursor":null},"meta":{"source":"github","license":null,"upstream":"api.github.com"}}}}},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"$ref":"#/components/responses/Error503"}}}},"/ops":{"get":{"operationId":"getOperations","tags":["Operations"],"summary":"Inspect job and map health","x-summary-fr":"Consulter la santé des tâches et cartes","description":"Public and unmetered. HTTP 200 or 503 uses the same envelope according to data.ok. Preparation counters alone do not change ok; inspect queue age and worker state separately. Health does not guarantee every file is available.","x-description-fr":"Public, sans crédits. HTTP 200 ou 503 utilise la même enveloppe selon data.ok. Les compteurs de préparation ne changent pas seuls ok; vérifiez séparément l’âge de la file et les processus. Aucune garantie pour chaque fichier.","x-credit-cost":0,"parameters":[],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Operations"},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":{"ok":true,"jobs":{"full":{"last_ok_at":"2026-01-01T00:00:00.000Z","status":"ok"}},"maps":{"pending":0,"deferred":0,"running":0,"ready":0,"skipped":0,"failed":0,"retrying_sources":0,"oldest_pending_at":null,"next_retry_at":null,"oldest_running_at":null,"last_indexed_at":null,"status":"ok"},"preparations":{"pending":0,"running":0,"failed_last_day":0,"completed_last_day":0,"oldest_pending_at":null}},"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null}}}}},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"description":"A job or map health check is degraded.","x-description-fr":"Une tâche ou une vérification cartographique est dégradée.","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/Operations"},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":{"ok":false,"jobs":{"full":{"last_ok_at":null,"status":"failed"}},"maps":{"pending":0,"deferred":0,"running":0,"ready":0,"skipped":0,"failed":0,"retrying_sources":0,"oldest_pending_at":null,"next_retry_at":null,"oldest_running_at":null,"last_indexed_at":null,"status":"ok"},"preparations":{"pending":0,"running":0,"failed_last_day":0,"completed_last_day":0,"oldest_pending_at":null}},"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null}}}}}},"security":[]}},"/healthz":{"get":{"operationId":"getHealth","tags":["Operations"],"summary":"Check database and federal upstream","x-summary-fr":"Vérifier la base et la source fédérale","description":"Site-root path /healthz (not /api/v1/healthz). Public, unmetered, unenveloped reachability check; not a worker or catalogue-wide availability check.","x-description-fr":"Route racine /healthz (pas /api/v1/healthz). Vérification publique sans crédits ni enveloppe; ne vérifie pas les processus ni tous les fichiers.","x-credit-cost":0,"parameters":[],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Health"},"example":{"ok":true,"db":true,"upstream":true}}}},"503":{"description":"Database or federal upstream probe failed.","x-description-fr":"La base ou la source fédérale ne répond pas.","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Health"},"example":{"ok":false,"db":false,"upstream":true}}}}},"servers":[{"url":"/"}],"security":[]}},"/readyz":{"get":{"operationId":"getReadiness","tags":["Operations"],"summary":"Check application and database availability","x-summary-fr":"Vérifier la disponibilité du service et de la base","description":"Site-root path. Public, unmetered and no-store. Checks database connectivity without requiring an upstream publisher or worker to be healthy.","x-description-fr":"Route racine, publique, sans crédits et sans cache. Vérifie la base sans dépendre de la santé des éditeurs ou des processus.","x-credit-cost":0,"parameters":[],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Readiness"},"example":{"ok":true,"db":true}}}},"503":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"}},"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Readiness"},"example":{"ok":false,"db":false}}}}},"servers":[{"url":"/"}],"security":[]}},"/ops/components/{component}":{"get":{"operationId":"getComponentHealth","tags":["Operations"],"summary":"Inspect one operational component","x-summary-fr":"Consulter un composant opérationnel","description":"Public, unmetered and no-store. Sanitized host observations older than 180 seconds fail closed with HTTP 503. Independent components separate availability, preparation, maps, sources, commercial backlogs, backups and storage. Existing /ops semantics remain unchanged.","x-description-fr":"Public, sans crédits et sans cache. Les observations de plus de 180 secondes donnent HTTP 503. Sépare disponibilité, préparation, cartes, sources, files commerciales, sauvegardes et stockage. Le comportement de /ops reste inchangé.","x-credit-cost":0,"parameters":[{"name":"component","in":"path","description":"Operational component to inspect.","x-description-fr":"Composant opérationnel à consulter.","schema":{"type":"string","enum":["availability","preparation","maps","sources","commercial","backups","storage"]},"required":true}],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/ComponentHealth"},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":{"component":"preparation","ok":true,"status":"ok","observed_at":"2026-01-01T00:00:00.000Z","checks":{"service_active":true,"stale_running":0}},"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null}}}}},"401":{"$ref":"#/components/responses/Error401"},"403":{"$ref":"#/components/responses/Error403"},"404":{"$ref":"#/components/responses/Error404"},"429":{"$ref":"#/components/responses/Error429"},"500":{"$ref":"#/components/responses/Error500"},"503":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"}},"content":{"application/json":{"schema":{"type":"object","properties":{"data":{"$ref":"#/components/schemas/ComponentHealth"},"pagination":{"$ref":"#/components/schemas/Pagination"},"meta":{"$ref":"#/components/schemas/Meta"}},"required":["data","pagination","meta"]},"example":{"data":{"component":"preparation","ok":false,"status":"stale","observed_at":null,"checks":{}},"pagination":{"nextCursor":null},"meta":{"source":"canquery","license":null,"upstream":null}}}}}},"security":[]}},"/openapi.json":{"get":{"operationId":"getOpenApi","tags":["Operations"],"summary":"Download the OpenAPI contract","x-summary-fr":"Télécharger le contrat OpenAPI","description":"Public, unmetered OpenAPI 3.1 document. Import into compatible developer tools. Examples are synthetic and do not establish current publisher data or availability.","x-description-fr":"Document OpenAPI 3.1 public, sans crédits. Importez-le dans vos outils compatibles. Exemples synthétiques, sans garantie de données ou disponibilité actuelles.","x-credit-cost":0,"parameters":[],"responses":{"200":{"description":"Successful response.","x-description-fr":"Réponse réussie.","headers":{"X-Request-Id":{"$ref":"#/components/headers/X-Request-Id"},"Cache-Control":{"$ref":"#/components/headers/Cache-Control"}},"content":{"application/json":{"schema":{"type":"object"}}}},"429":{"$ref":"#/components/responses/Error429"}},"security":[]}}}}"`;

exports[`combined build output (live) initial HTML, status and cache headers 1`] = `
{
  "/": {
    "body": "<!doctype html><html><head><!-- seo:start -->
    <title>Canadian open data &amp; government datasets - CanQuery</title>
    <meta name="description" content="Search Canadian government datasets by place and topic. Find CSV downloads, explore supported tables and maps, and use CanQuery’s free API." />
    <link rel="canonical" href="https://canquery.com/" />
    <meta property="og:title" content="Canadian open data &amp; government datasets - CanQuery" />
    <meta property="og:description" content="Search Canadian government datasets by place and topic. Find CSV downloads, explore supported tables and maps, and use CanQuery’s free API." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://canquery.com/" />
    <meta property="og:site_name" content="CanQuery" />
    <meta property="og:image" content="https://canquery.com/og-image.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Canadian open data &amp; government datasets - CanQuery" />
    <meta name="twitter:description" content="Search Canadian government datasets by place and topic. Find CSV downloads, explore supported tables and maps, and use CanQuery’s free API." />
    <meta name="twitter:image" content="https://canquery.com/og-image.svg" />
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"WebSite","name":"CanQuery","alternateName":"Canadian open data \\u0026 government datasets - CanQuery","url":"https://canquery.com/","description":"Search Canadian government datasets by place and topic. Find CSV downloads, explore supported tables and maps, and use CanQuery’s free API.","potentialAction":{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https://canquery.com/?q={search_term_string}"},"query-input":"required name=search_term_string"}}</script>
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"CanQuery","url":"https://canquery.com/","logo":"https://canquery.com/favicon.svg","sameAs":["https://github.com/RyuPrad/canquery"]}</script>
    <!-- seo:end --><meta name="canquery-analytics-site" content="01a02c60-cd0a-77f4-8680-7e9e317534a1" /></head><body><div id="root"><main class="cq-seo-snapshot max-w-5xl mx-auto px-4 py-8" data-cq-seo-snapshot="true"><article><h1>Search Canadian open data</h1><p>Search Canadian government datasets by place and topic. Find CSV downloads, explore supported tables and maps, and use CanQuery’s free API.</p><section><h2>How CanQuery works</h2><ol><li><h3>Search government datasets</h3><p>Find Canadian government datasets by place, topic, publisher and format.</p></li><li><h3>Choose a download, table or map</h3><p>Download original files, prepare eligible CSV and Excel files as tables, or explore supported maps.</p></li><li><h3>Filter, export or use the API</h3><p>Filter and sort supported tables, export up to 10,000 rows as CSV, or query data with CanQuery’s free API.</p></li></ol></section><section><h2>Explore CanQuery</h2><ul><li><a href="/datasets">Browse all datasets</a></li><li><a href="/places">Browse open data by place</a></li><li><a href="/blog">Read data guides</a></li><li><a href="/organizations">Browse publishing organizations</a></li><li><a href="/insights">Explore popular dataset insights</a></li><li><a href="/docs">Use the CanQuery API</a></li></ul></section><section><h2>Data guides</h2><ul><li><a href="/blog/find-lmia-employer-lists">Find LMIA employer lists by quarter and file language</a> <span>Choose an official positive-LMIA employer file, inspect its columns, and understand the difference between approved positions and job vacancies.</span></li><li><a href="/blog/download-statistics-canada-csv">Download and read a Statistics Canada CSV table</a> <span>Use table 35-10-0007 to find a CSV archive, extract its data and metadata, and check dimensions and status flags before comparing values.</span></li><li><a href="/blog/uxbridge-ward-boundaries-map">Explore Uxbridge ward boundaries on a map</a> <span>Open Durham Region’s Uxbridge ward layer, read its WARD and LABEL fields, and choose between the interactive map and source downloads.</span></li></ul></section></article></main></div></body></html>",
    "cacheControl": "public, max-age=0, must-revalidate",
    "location": null,
    "status": 200,
  },
  "/about": {
    "body": "<!doctype html><html><head><!-- seo:start -->
    <title>About CanQuery - CanQuery</title>
    <meta name="description" content="Learn about CanQuery, an independent, open-source project for finding and working with Canadian public data, and how to contact support." />
    <link rel="canonical" href="https://canquery.com/about" />
    <meta property="og:title" content="About CanQuery - CanQuery" />
    <meta property="og:description" content="Learn about CanQuery, an independent, open-source project for finding and working with Canadian public data, and how to contact support." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://canquery.com/about" />
    <meta property="og:site_name" content="CanQuery" />
    <meta property="og:image" content="https://canquery.com/og-image.svg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="About CanQuery - CanQuery" />
    <meta name="twitter:description" content="Learn about CanQuery, an independent, open-source project for finding and working with Canadian public data, and how to contact support." />
    <meta name="twitter:image" content="https://canquery.com/og-image.svg" />
    <!-- seo:end --><meta name="canquery-analytics-site" content="01a02c60-cd0a-77f4-8680-7e9e317534a1" /><link rel="modulepreload" crossorigin href="/assets/AboutPage-abc123.js" />
<link rel="stylesheet" crossorigin href="/assets/AboutPage-abc123.css" />
<link rel="modulepreload" crossorigin href="/assets/shared-abc123.js" />
</head><body><div id="root"><main class="cq-seo-snapshot max-w-5xl mx-auto px-4 py-8" data-cq-seo-snapshot="true"><nav aria-label="Breadcrumb"><ol><li><a href="/">CanQuery</a></li><li><span aria-current="page">About CanQuery</span></li></ol></nav><article><h1>About CanQuery</h1><p>Canadian public data is published across many portals. CanQuery brings those catalogues together so you can search by place or topic, find the original source and work with supported data in one place.</p><section><h2>Find the data. Keep the context.</h2><p>CanQuery is for anyone exploring Canadian public data, from curious residents to researchers and developers building reports or dashboards. The website and API help you discover datasets without losing sight of who published them or what they cover.</p></section><section><h2>From public sources to useful tools</h2><p>CanQuery mirrors catalogue metadata from Canadian federal, municipal, regional and territorial publishers. You can follow original download links, query supported live tables, prepare eligible CSV and Excel files, and explore supported maps. Availability depends on the resource and its publisher.</p><p>Each dataset keeps its publisher, source links and applicable licence. Field meanings and coverage remain publisher-specific. Check the original source and attribution requirements when using the data.</p></section><section><h2>Independently built, openly shared</h2><p>CanQuery is an independent project and is not affiliated with the Government of Canada. It is built by @RyuPrad, and its source code is available under the MIT licence. The software licence is separate from the licences that apply to the published data.</p></section><p><a href="https://github.com/RyuPrad">Meet the creator on GitHub</a> · <a href="https://github.com/RyuPrad/canquery">Explore the source code</a></p><section id="support"><h2>Contact support</h2><p>Have a question, found a bug or need account help? Email us at: <a href="mailto:support@canquery.com">support@canquery.com</a></p><p>For a technical issue, include the page or resource URL, what you were trying to do and the error message. If available, include the time, HTTP status and X-Request-Id. Leave out API keys, passwords and sensitive query contents.</p><p>For the first few customers, the founder can help by email with one existing supported resource and one working query. Custom integrations need a separate scope.</p></section><section><h2>Explore CanQuery</h2><ul><li><a href="/datasets">Browse the catalogue</a></li><li><a href="/faq">Read the FAQ</a></li></ul></section></article></main></div></body></html>",
