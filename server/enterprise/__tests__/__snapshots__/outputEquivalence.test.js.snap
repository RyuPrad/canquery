  "/docs": {
    "body": "<!doctype html><html><head><!-- seo:start -->
    <title>Canadian open data API documentation - CanQuery</title>
    <meta name="description" content="Build with Canadian public data: working curl, Python and JavaScript examples, endpoint reference, API keys, pagination, preparation and error handling." />
