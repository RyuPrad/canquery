{
    "name": "canquery-server",
    "version": "1.0.0",
    "private": true,
    "description": "One consistent query API over Canada's open data portal: catalogue mirror, datastore proxy, and on-demand CSV/Excel ingestion.",
    "license": "MIT",
    "author": "RyuPrad",
    "homepage": "https://canquery.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/RyuPrad/canquery.git"
    },
    "bugs": {
        "url": "https://github.com/RyuPrad/canquery/issues"
    },
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "node --watch server.js",
        "test": "jest --runInBand",
        "migrate": "node scripts/migrate.js",
        "sync:places": "node scripts/sync-places.js",
        "sync:source": "node scripts/sync-source.js",
        "sync:municipal": "node scripts/sync-municipal-sources.js",
        "maps:once": "node scripts/map-worker.js --once",
        "maps:drain": "node scripts/map-worker.js --drain",
        "gsc:authorize": "node scripts/authorize-search-console.js",
        "gsc:sync": "node scripts/sync-search-console.js",
        "gsc:report": "node scripts/build-search-growth-report.js",
        "lint": "eslint ."
    },
    "dependencies": {
        "csv-parse": "^6.2.1",
        "dotenv": "^16.4.0",
        "exceljs": "^4.4.0",
        "express": "^5.1.0",
        "express-rate-limit": "^7.4.0",
        "google-auth-library": "^10.9.1",
        "helmet": "^8.0.0",
        "pg": "^8.13.0",
        "pg-copy-streams": "^7.0.0",
        "stream-json": "2.1.0",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.4.1",
        "globals": "^17.6.0",
        "jest": "^29.7.0",
        "supertest": "^7.0.0"
    }
}
