# /etc/systemd/system/canquery-worker.service
# Long-running ingest worker that drains the ingest queue.
[Unit]
Description=canquery ingest worker (drains ingest_jobs)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=canquery-egress-firewall.service
After=canquery-egress-firewall.service

[Service]
Type=simple
User=canquery-ingest
Group=canquery-ingest
WorkingDirectory=/opt/canquery/current/server
ExecStart=/usr/bin/node scripts/ingest-worker.js
Environment=TMPDIR=/tmp
Environment=NODE_ENV=production
EnvironmentFile=/etc/canquery/runtime/canquery-ingest.env
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
# The worker handles SIGTERM by finishing its active ingest and then releasing
# its database queue lock. A hard timeout is still finite; the replacement
# worker immediately requeues a job if this process must be killed.
# Cover the default 30-minute preparation deadline plus cancellation/cleanup.
# Review this grace whenever INGEST_DEADLINE_MS changes.
TimeoutStopSec=32min

# Excel conversion can inflate compressed workbook data substantially. These
# defaults protect a shared host; operators can tune them with a systemd drop-in.
MemoryHigh=768M
MemoryMax=1G

ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
