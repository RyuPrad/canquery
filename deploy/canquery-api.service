# /etc/systemd/system/canquery-api.service
# Runtime configuration is root-private and supplied by systemd.
# The sealed release has no .env and is read-only to every runtime identity.
[Unit]
Description=canquery API (Express, :3100)
After=network-online.target
Wants=network-online.target
Requires=canquery-egress-firewall.service
After=canquery-egress-firewall.service

[Service]
Type=simple
User=canquery-api
Group=canquery-api
WorkingDirectory=/opt/canquery/current/server
ExecStart=/usr/bin/node server.js
Environment=NODE_ENV=production
EnvironmentFile=/etc/canquery/runtime/canquery-api.env
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=300

# Hardening
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
