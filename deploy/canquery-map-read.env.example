# Install as /etc/canquery-map-read.env, root:<app-group>, mode 0640.
# Use a bucket-scoped R2 S3 credential with Object Read only.
MAP_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
MAP_R2_BUCKET=<private-bucket-name>
MAP_R2_ACCESS_KEY_ID=<read-only-access-key-id>
MAP_R2_SECRET_ACCESS_KEY=<read-only-secret-access-key>
MAP_R2_REGION=auto
