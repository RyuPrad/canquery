# Install as /etc/canquery-map-write.env, root:<app-group>, mode 0640.
# Use a separate bucket-scoped R2 S3 credential with Object Read & Write.
MAP_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
MAP_R2_BUCKET=<private-bucket-name>
MAP_R2_ACCESS_KEY_ID=<worker-access-key-id>
MAP_R2_SECRET_ACCESS_KEY=<worker-secret-access-key>
MAP_R2_REGION=auto
MAP_R2_BUDGET_GB=100
MAP_R2_ORPHAN_GRACE_HOURS=24
MAP_R2_PRUNE_MAX=1000
TIPPECANOE_PATH=/opt/canquery-tippecanoe/current/bin/tippecanoe
