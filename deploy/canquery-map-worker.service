# /etc/systemd/system/canquery-map-worker.service
# Single-concurrency PostGIS map-index worker.
[Unit]
Description=canquery local map index worker (drains map_index_jobs)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=canquery-egress-firewall.service
After=canquery-egress-firewall.service

[Service]
Type=simple
User=canquery
Group=canquery
WorkingDirectory=/home/canquery/canquery/server
ExecStart=/usr/bin/node scripts/map-worker.js
Environment=NODE_ENV=production
EnvironmentFile=-/etc/canquery-map-write.env
# Direct GeoJSON files can contain a few very large Feature objects. stream-json
# bounds the collection, but each feature still needs enough heap to be assembled.
Environment=NODE_OPTIONS=--max-old-space-size=2048
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=20min

Nice=10
IOSchedulingClass=idle
MemoryHigh=2G
MemoryMax=3G

ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/canquery/canquery/server /tmp /var/tmp
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
